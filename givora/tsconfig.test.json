{
  // Node ne résout pas les imports relatifs sans extension : on compile
  // en CommonJS dans .test-build/ et les tests requièrent ça.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-build",
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": []
  },
  "include": ["src/lib/**/*.ts"]
}
