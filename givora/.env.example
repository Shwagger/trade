# =====================================================================
# Givora — variables d'environnement
# Copier en .env.local et remplir. Rien ici n'est commité.
# =====================================================================

# --- Supabase -----------------------------------------------------------
# Sans ces deux variables l'app tourne quand même : elle bascule sur un
# store en mémoire (dev uniquement, tout est perdu au redémarrage).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Moteur IA : OPTIONNEL, ÉTEINT, ET PAYANT ---------------------------
# Le moteur du produit est l'algorithme (src/lib/engine) : gratuit,
# instantané, zéro coût par session. Il n'y a AUCUNE raison de remplir ces
# deux lignes pour lancer le produit.
#
# Il faut les DEUX pour que l'IA s'allume — une clé seule ne déclenche
# jamais de facture par surprise.
# USE_AI_ENGINE=1
# ANTHROPIC_API_KEY=

# --- Affiliation : c'est le revenu -------------------------------------
# Un identifiant manquant = trafic envoyé gratuitement au marchand.
# /admin affiche lesquels sont branchés.
# ⚠️ Vérifie le format de chaque lien dans src/lib/affiliates.ts avant de
# lancer du trafic dessus : chaque programme a ses propres paramètres.
AMAZON_BR_TAG=
MERCADO_LIVRE_TAG=
MAGALU_TAG=
SHOPEE_TAG=

# --- Panneau /admin -----------------------------------------------------
# Non défini = panneau fermé. Il n'y a pas de valeur par défaut, exprès.
ADMIN_PASSWORD=
